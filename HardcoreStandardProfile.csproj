<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>HardcoreStandardProfile</RootNamespace>
		<AssemblyName>HardcoreStandardProfile</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Version>1.0.0</Version>
		<OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="SPTarkov.Common" Version="4.1.2" />
		<PackageReference Include="SPTarkov.DI" Version="4.1.2" />
		<PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
	</ItemGroup>
	<ItemGroup>
		<None Update="data\bear_inventory.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="data\usec_inventory.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>